DATABASE_URL=postgresql://sba:sba_dev_password@localhost:5432/sba_sports_os
# 3001, no 3000 — el frontend (web/) corre en 3000; 3000 también choca con otro proyecto local
# del usuario (smt-developer).
PORT=3001
# HMAC de desarrollo local únicamente — JwtStrategy exige que exista, pero NUNCA usar un secreto
# compartido en staging/prod (ahí la verificación real es contra Auth0/Cognito, ver CLAUDE.md).
JWT_SECRET=dev-only-change-me
